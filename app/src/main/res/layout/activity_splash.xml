<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFFFFF"
    android:padding="32dp">

    <!-- Teks besar "Android SQLite Database" seperti slide (merah/oranye) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Android\nSQLite Database"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FF5722"  <!-- Merah/oranye seperti slide -->
    android:gravity="center"
    android:layout_marginBottom="16dp" />

    <!-- Garis biru bawah seperti slide -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#2196F3"
        android:layout_marginBottom="32dp" />

    <!-- Teks bawah slide -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wireless and Mobile Programming /\nMobile Programming Class\nWeek 05"
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="48dp" />

    <!-- Button Start -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start"
        android:textSize="18sp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp" />

</LinearLayout>